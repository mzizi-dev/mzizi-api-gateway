{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mzizi-api-gateway",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-05-22",
  "account_id": "125a2dfbc21f76a25c980609609e8218",

  // workers-rs compiles to WASM through worker-build, which emits the JS shim
  // named in `main` and the wasm beside it.
  //
  // The pin tracks the `worker` dependency in Cargo.toml: since workers-rs 0.7
  // the library and the build tool are released in lockstep and worker-build
  // rejects a library outside its own minor line. It also matters for a reason
  // that is not obvious — worker-build 0.8 reads the resolved wasm-bindgen
  // version from Cargo.lock and downloads exactly that CLI, whereas the 0.1
  // line hard-codes one (0.2.105) that has nothing to do with what the crate
  // compiled against. wasm-bindgen refuses to process a module built by a
  // different version of itself, so `^0.1` against worker 0.8 cannot build.
  //
  // This command is duplicated in .github/workflows/ci.yml on purpose: this one
  // is what Cloudflare Workers Builds actually runs, so if they drift the deploy
  // breaks while CI stays green. Change both or neither.
  "build": {
    "command": "cargo install -q worker-build --version ^0.8 && worker-build --release",
  },

  // A custom domain takes a BARE HOSTNAME. Wildcards and paths are rejected
  // ("Wildcard operators (*) are not allowed in Custom Domains"), and a custom
  // domain already routes every path on the hostname here, so a `/*` is both
  // invalid and redundant. `zone_name` is inferred and only means anything on a
  // non-custom-domain route.
  //
  // Written this way from the start because the same three-field form silently
  // broke two Workers in this org: mzizi-mcp (agent-tools#102) and the console,
  // which never deployed at all. Workers Builds previews upload a version
  // WITHOUT applying routes, so the config is only validated on the production
  // deploy — the same commit reads green on a PR and red on main.
  "routes": [
    {
      "pattern": "api.mzizi.dev",
      "custom_domain": true,
    },
  ],

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "placement": { "mode": "smart" },
}
