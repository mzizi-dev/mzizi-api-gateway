{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mzizi-api-gateway",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-05-22",
  "account_id": "125a2dfbc21f76a25c980609609e8218",

  // workers-rs compiles to WASM through worker-build, which emits the JS shim
  // named in `main` and the wasm beside it.
  "build": {
    "command": "cargo install -q worker-build --version ^0.1 && worker-build --release",
  },

  // A custom domain takes a BARE HOSTNAME. Wildcards and paths are rejected
  // ("Wildcard operators (*) are not allowed in Custom Domains"), and a custom
  // domain already routes every path on the hostname here, so a `/*` is both
  // invalid and redundant. `zone_name` is inferred and only means anything on a
  // non-custom-domain route.
  //
  // Written this way from the start because the same three-field form silently
  // broke two Workers in this org: mzizi-mcp (agent-tools#102) and the console,
  // which never deployed at all. Workers Builds previews upload a version
  // WITHOUT applying routes, so the config is only validated on the production
  // deploy — the same commit reads green on a PR and red on main.
  "routes": [
    {
      "pattern": "api.mzizi.dev",
      "custom_domain": true,
    },
  ],

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "placement": { "mode": "smart" },
}
