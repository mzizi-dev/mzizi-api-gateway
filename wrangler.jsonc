{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mzizi-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "account_id": "125a2dfbc21f76a25c980609609e8218",

  // Hono on Workers needs no Node built-ins, so no `nodejs_compat`.
  //
  // The data every route serves is generated here, from mzizi-registry's files
  // at the ref pinned in scripts/registry-ref.json, and bundled into the Worker
  // as JSON modules (src/data/, gitignored). Running it as wrangler's custom
  // build means `wrangler dev`, `wrangler deploy` and Cloudflare Workers Builds
  // all produce the same bundle from the same pin with no extra step — as long
  // as `npm ci` ran first, which Workers Builds does on its own when it sees
  // package-lock.json.
  "build": {
    "command": "node scripts/build-data.mjs",
  },

  // NO `routes` HERE, ON PURPOSE. This file used to declare `api.mzizi.dev` as a
  // custom domain. api.mzizi.dev is currently attached to the `mzizi-registry`
  // Worker, and a production deploy of this Worker with that route would move
  // the hostname the moment this is merged and built — a cutover nobody chose
  // to make at that moment. Deploys land on workers.dev only; moving the custom
  // domain is a deliberate owner step (README, "Cutover"). When it is moved for
  // good, add the route back in this exact form — a BARE hostname, no `/*`, no
  // `zone_name` (the three-field form broke mzizi-mcp and the console):
  //
  //   "routes": [{ "pattern": "api.mzizi.dev", "custom_domain": true }],
  "workers_dev": true,

  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
